# Copy to .env, fill in, and run:
#   npx hardhat run scripts/deploy.js --network sepolia
# Then copy the printed contract address into backend/.env as CONTRACT_ADDRESS.

# Free RPC endpoint for Sepolia — get one from https://www.alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Private key of a TESTNET-ONLY wallet (e.g. a fresh MetaMask account) used
# only to pay gas for deployment — NOT an institution's signing key.
# Fund it with free test ETH from a faucet such as https://sepoliafaucet.com
# NEVER use a wallet that holds real funds or reuse this key anywhere else.
DEPLOYER_PRIVATE_KEY=

# BIP-39 mnemonic used to derive one signing wallet per institution.
# MUST be the exact same value as backend/.env's BLOCKCHAIN_MNEMONIC — this
# script derives addresses from it and authorises them on-chain at deploy
# time. Generate a fresh dev-only phrase, e.g. via `npx hardhat node` output.
BLOCKCHAIN_MNEMONIC=
# How many institution wallets (indices 0..N-1) to derive and authorise.
INSTITUTION_WALLET_COUNT=4
