# Copy this file to .env.local (already gitignored via *.local) for local overrides.
# Base URL the frontend calls for the backend API. Must be a host reachable from
# whatever device loads the page — "localhost" only ever means "this device", so:
#   - Same machine only:            http://localhost:5000/api   (default if unset)
#   - Phone on the same Wi-Fi:      http://<your-PC-LAN-IP>:5000/api
#   - Deployed frontend:            https://<your-deployed-backend-domain>/api
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL embedded in printed certificates' QR codes. Same "localhost only
# means this device" problem as above: if left unset it falls back to
# window.location.origin, which only works if you always open this app via
# your LAN IP rather than localhost. Set it explicitly for LAN testing:
#   VITE_PUBLIC_BASE_URL=http://<your-PC-LAN-IP>:5173
VITE_PUBLIC_BASE_URL=
