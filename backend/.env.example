# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=cert_verification_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Blockchain
# Local dev (Ganache):   BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Deployed (Sepolia via a free Alchemy/Infura RPC): BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Address CertificateRegistry.sol was deployed to (see blockchain/scripts/deploy.js output)
CONTRACT_ADDRESS=
# BIP-39 mnemonic used to derive one signing wallet per institution
# (m/44'/60'/0'/0/<institutions.wallet_index>). MUST be the exact same value
# as blockchain/.env's BLOCKCHAIN_MNEMONIC, since deploy.js authorises the
# addresses derived from that mnemonic on-chain.
# NEVER use a mnemonic holding real funds — use a dedicated Ganache/testnet-only phrase.
BLOCKCHAIN_MNEMONIC=
