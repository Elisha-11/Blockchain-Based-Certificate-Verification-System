# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=3306

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=Mad2bhere
DB_NAME=cert_verification_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Blockchain
# Local dev (Ganache):   BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Deployed (Sepolia via a free Alchemy/Infura RPC): BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Address CertificateRegistry.sol was deployed to (see blockchain/scripts/deploy.js output)
CONTRACT_ADDRESS=0xB6fB60dF9FB135D08A0807aC3711F94f5cF15e94
# Private key of the wallet that will sign blockchain transactions.
# NEVER use a wallet holding real funds — use a dedicated Ganache/testnet-only key.
BLOCKCHAIN_PRIVATE_KEY=
